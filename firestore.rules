rules_version = '2';

// Regole di sicurezza per Casa Comperotto.
// Da incollare in Firebase → Firestore Database → Regole, sostituendo le email
// con le vostre due + quella dell'account creato per Alexa.
service cloud.firestore {
  match /databases/{database}/documents {

    function diCasa() {
      return request.auth != null
        && request.auth.token.email in [
          'prima-email@esempio.it',
          'seconda-email@esempio.it',
          'alexa@esempio.it'
        ];
    }

    match /case/{casa}/{documento=**} {
      allow read, write: if diCasa();
    }
  }
}
